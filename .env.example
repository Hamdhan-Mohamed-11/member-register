# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayHere (sandbox until the VPS is live)
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# SMTP for auth email -- signup confirmation codes and password reset codes are
# sent by the app itself (nodemailer), not by Supabase. Port 465 is implicit
# TLS; anything else must offer STARTTLS or the send is refused rather than
# putting a one-time code on the wire in plaintext.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pickabook.lk
SMTP_FROM_NAME=Pick a Book

# The PaB Store -- where the BUYING catalogue comes from.
#
# Point this at the store's site. The portal reads the catalogue file the
# store already publishes (data/books.json -- the same file its own
# load_books() reads) once a minute, and serves members from its own cache.
# Borrowing is unaffected: the club lends its own books from its own shelf.
#
# Leave PAB_STORE_URL empty and /books says the catalogue is not configured
# rather than showing an empty shop.
PAB_STORE_URL=
# Where the catalogue sits under that URL. books.json.php is the alternative
# for a store that would rather not publish its catalogue (see
# store-endpoint/ in this repo).
PAB_STORE_BOOKS_PATH=data/books.json
# Optional shared secret. Set the same value as PAB_STORE_TOKEN on the store
# and the endpoint answers 404 to anyone without it.
PAB_STORE_TOKEN=
