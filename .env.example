# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayHere (sandbox until the VPS is live)
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# SMTP for auth email -- signup confirmation codes and password reset codes are
# sent by the app itself (nodemailer), not by Supabase. Port 465 is implicit
# TLS; anything else must offer STARTTLS or the send is refused rather than
# putting a one-time code on the wire in plaintext.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pickabook.lk
SMTP_FROM_NAME=Pick a Book
